# ═══════════════════════════════════════════════════════════════
# ProofShield Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Port for Express server
PORT=3000

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=proofshield_super_secure_random_secret_string_32_characters_minimum

# MongoDB Atlas Configuration
# Replace with your actual MongoDB Atlas connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?appName=<cluster-name>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/proofshield?retryWrites=true&w=majority
MONGODB_DB_NAME=proofshield

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Local redirect URI for Vite -> Express API proxy: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Midnight Network Configuration
MIDNIGHT_NETWORK=local
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_INDEXER_URL=http://localhost:8088

# Public Vite value. Set after the single shared Preprod contract is deployed.
VITE_CONTRACT_ADDRESS=
