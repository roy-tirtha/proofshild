# ProofShield — Preprod environment
# Copy this file to .env.preprod (DO NOT COMMIT .env.preprod)
# Fund your wallet at: https://midnight-tmnight-preprod.nethermind.dev/

# Use ONE of the following (not both):
# MIDNIGHT_PREPROD_MNEMONIC="word1 word2 word3 ... word24"
# MIDNIGHT_PREPROD_SEED=<hex-seed-no-0x-prefix>

# Optional overrides:
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# MIDNIGHT_SYNC_TIMEOUT_MS=3600000
