# ProofShield — Preview environment
# Copy this file to .env.preview (DO NOT COMMIT .env.preview)
# Fund your wallet at: https://midnight-tmnight-preview.nethermind.dev/

# Use ONE of the following (not both):
# MIDNIGHT_PREVIEW_MNEMONIC="word1 word2 word3 ... word24"
# MIDNIGHT_PREVIEW_SEED=<hex-seed-no-0x-prefix>

# Optional overrides:
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
# MIDNIGHT_SYNC_TIMEOUT_MS=3600000
