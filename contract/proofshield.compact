pragma language_version 0.23;

import CompactStandardLibrary;

enum AuctionPhase { UNINITIALIZED, COMMIT, REVEAL, FINALIZED }

export ledger phase: AuctionPhase;
export ledger reserve_price: Uint<64>;
export ledger auction_owner_commitment: Bytes<32>;
export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger revealed_bids: Map<Bytes<32>, Uint<64>>;
export ledger highest_bid: Uint<64>;
export ledger winning_commitment: Bytes<32>;
export ledger reveal_count: Counter;

export pure circuit bid_commitment(amount: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "proofshield:auction:bid:v1"),
    (amount as Field) as Bytes<32>,
    salt,
  ]);
}

export pure circuit owner_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "proofshield:auction:owner:v1"),
    secret,
  ]);
}

export circuit start_auction(reserve: Uint<64>, owner_secret: Bytes<32>): [] {
  assert(phase == AuctionPhase.UNINITIALIZED, "auction has already started");
  assert(reserve > 0, "reserve price must be positive");
  reserve_price = disclose(reserve);
  auction_owner_commitment = disclose(owner_commitment(owner_secret));
  highest_bid = disclose(0);
  phase = disclose(AuctionPhase.COMMIT);
}

export circuit commit_bid(commitment: Bytes<32>): [] {
  assert(phase == AuctionPhase.COMMIT, "auction is not accepting commitments");
  assert(!commitments.member(disclose(commitment)), "commitment already submitted");
  commitments.insert(disclose(commitment), disclose(false));
}

export circuit close_bidding(owner_secret: Bytes<32>): [] {
  assert(phase == AuctionPhase.COMMIT, "bidding is not open");
  assert(owner_commitment(owner_secret) == auction_owner_commitment, "only the auction creator may close bidding");
  phase = disclose(AuctionPhase.REVEAL);
}

export circuit reveal_bid(amount: Uint<64>, salt: Bytes<32>): [] {
  assert(phase == AuctionPhase.REVEAL, "auction is not in reveal phase");
  const commitment = disclose(bid_commitment(amount, salt));
  assert(commitments.member(commitment), "no matching bid commitment");
  assert(!commitments.lookup(commitment), "bid has already been revealed");
  commitments.insert(disclose(commitment), disclose(true));
  revealed_bids.insert(disclose(commitment), disclose(amount));
  reveal_count.increment(1);
  const meetsReserve = disclose(amount >= reserve_price);
  const beatsHighest = disclose(amount > highest_bid);
  if (meetsReserve && beatsHighest) {
    highest_bid = disclose(amount);
    winning_commitment = disclose(commitment);
  }
}

export circuit finalize_auction(owner_secret: Bytes<32>): [] {
  assert(phase == AuctionPhase.REVEAL, "auction is not in reveal phase");
  assert(owner_commitment(owner_secret) == auction_owner_commitment, "only the auction creator may finalize");
  phase = disclose(AuctionPhase.FINALIZED);
}
