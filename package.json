{
  "name": "proofshield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProofShield - Privacy-first technical achievement verification on Midnight",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "compact compile contract/proofshield.compact contract/managed/proofshield",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run",
    "test:local": "MIDNIGHT_NETWORK=local yarn test",
    "test:preview": "MIDNIGHT_NETWORK=preview yarn test",
    "test:preprod": "MIDNIGHT_NETWORK=preprod yarn test",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.5",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.15.0",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "resolutions": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/zkir-v2": "2.1.0"
  },
  "packageManager": "yarn@1.22.22"
}
