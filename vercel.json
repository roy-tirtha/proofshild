{
  "framework": "vite",
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/auction", "destination": "/auction.html" },
    { "source": "/proof", "destination": "/auction.html" }
  ]
}
